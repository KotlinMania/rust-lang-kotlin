package = io.github.kotlinmania.rustlang.libc.windows.cinterop
headers = windows_wrapper.h
headerFilter = windows_wrapper.h
compilerOpts = -Isrc/native/interop/cinterop
staticLibraries = windows_wrapper.a
linkerOpts.mingw = -lws2_32
noStringConversion = libcWindowsPrintf libcWindowsFprintf libcWindowsSnprintf libcWindowsSprintf libcWindowsScanf libcWindowsSscanf libcWindowsFscanf libcWindowsFopen libcWindowsFreopen libcWindowsRemove libcWindowsRename libcWindowsSetvbuf libcWindowsSetbuf libcWindowsFgets libcWindowsFputs libcWindowsPuts libcWindowsPerror libcWindowsAtof libcWindowsAtoi libcWindowsAtol libcWindowsAtoll libcWindowsStrtod libcWindowsStrtof libcWindowsStrtol libcWindowsStrtoll libcWindowsStrtoul libcWindowsStrtoull libcWindowsSystem libcWindowsGetenv libcWindowsStrcpy libcWindowsStrncpy libcWindowsStrcat libcWindowsStrncat libcWindowsStrcmp libcWindowsStrncmp libcWindowsStrcoll libcWindowsStrchr libcWindowsStrrchr libcWindowsStrspn libcWindowsStrcspn libcWindowsStrdup libcWindowsStrpbrk libcWindowsStrstr libcWindowsStrlen libcWindowsStrnlen libcWindowsStrtok libcWindowsStrxfrm libcWindowsWcstombs libcWindowsGetTzname libcWindowsChmod libcWindowsMkdir libcWindowsStat libcWindowsPopen libcWindowsFdopen libcWindowsOpen libcWindowsCreat libcWindowsAccess libcWindowsChdir libcWindowsExecl libcWindowsExecle libcWindowsExeclp libcWindowsExeclpe libcWindowsExecv libcWindowsExecve libcWindowsExecvp libcWindowsExecvpe libcWindowsGetcwd libcWindowsRmdir libcWindowsUnlink libcWindowsSetlocale libcWindowsPutenv libcWindowsPutenvS libcWindowsGetsockopt libcWindowsRecvfrom libcWindowsSendto libcWindowsSetsockopt
