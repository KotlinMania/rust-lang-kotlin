package = io.github.kotlinmania.rustlang.std.sys.fs.unix.cinterop
headers = std_sys_fs_unix_wrapper.h
headerFilter = std_sys_fs_unix_wrapper.h
compilerOpts = -Isrc/native/interop/cinterop
staticLibraries = std_sys_fs_unix_wrapper.a
linkerOpts.mingw = -lws2_32
noStringConversion = rustlangStdSysFsUnixOpen
